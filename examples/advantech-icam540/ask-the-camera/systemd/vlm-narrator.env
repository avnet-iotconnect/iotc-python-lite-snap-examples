# /etc/default/vlm-narrator : settings for vlm-narrator.service (restart the service after editing)
VLM_INTERVAL=8
VLM_WEB=8088
VLM_FOCUS=auto
VLM_MODEL=qwen3-vl:2b-instruct
VLM_ZOOM=saved   # or 1.0-4.0; 2.7 = the sensor's native window
VLM_ROTATE=0
# snap sockets (root-owned, world-writable); the narrator also finds them on its own
IOTC_SOCKET=/var/snap/iotconnect/common/iotc.sock
IOTC_CMD_SOCK=/var/snap/iotconnect/common/iotc_cmd.sock
