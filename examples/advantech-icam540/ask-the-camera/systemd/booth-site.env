# /etc/default/booth-site : credentials and settings for booth-site.service.
# Keep this file root-owned with mode 600: it holds the portal password and the solution key.
IOTC_USERNAME=you@example.com
IOTC_PASSWORD=change-me
IOTC_SOLUTION_KEY=your-solution-key
IOTC_PLATFORM=aws
IOTC_ENV=poc
IOTC_DEVICE_IDS=mclAdvICAM540b
BOOTH_PORT=8090
BOOTH_TITLE=Ask the camera
BOOTH_SUBTITLE=Advantech iCAM-540 + NVIDIA Jetson Orin + /IOTCONNECT
BOOTH_LIVE_VIEW=http://127.0.0.1:8088
BOOTH_POLL_S=3
BOOTH_TZ=America/Chicago
