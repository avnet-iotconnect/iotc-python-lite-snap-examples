[Unit]
Description=/IOTCONNECT PHT (MS8607) telemetry
Documentation=https://github.com/avnet-iotconnect/iotc-python-lite-snap-examples/tree/main/examples/microchip-curiosity-pic64gx1000
After=network-online.target snap.iotconnect.socket.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu

# /dev/i2c-* is root:i2c mode 660. Without this the service cannot open the
# bus and retries forever with PermissionError.
SupplementaryGroups=i2c

# Python buffers stdout when it is not a terminal, which hides print() output
# from the journal until several kilobytes accumulate.
Environment=PYTHONUNBUFFERED=1

# Defaults first, then the environment file overrides them if it exists.
Environment=IOTC_SOCK=/var/snap/iotconnect/common/iotc.sock
Environment=PHT_I2C_BUS=0
Environment=PHT_INTERVAL=10
EnvironmentFile=-/etc/default/iotc-examples

WorkingDirectory=/home/ubuntu/iotc-python-lite-snap-examples/examples/microchip-curiosity-pic64gx1000/applications
ExecStart=/usr/bin/python3 pht_iotc_socket.py

# The application retries a missing socket and a missing sensor on its own,
# so a restart here only covers an outright crash.
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
