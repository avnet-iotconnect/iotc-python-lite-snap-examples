# /etc/default/iotc-examples
#
# Shared configuration for the PIC64GX1000 example services. Installed by
# install-services.sh, which fills in the paths it detects on this board.
# Edit, then: sudo systemctl restart iotc-pht.service iotc-vision.service

# --- /IOTCONNECT sockets -----------------------------------------------------
# These are the paths the bridge creates when it runs as a root service
# (sudo snap start iotconnect.socket). An unprivileged bridge uses
# ~/snap/iotconnect/common/ instead, but it cannot start at boot.
IOTC_SOCK=/var/snap/iotconnect/common/iotc.sock
IOTC_CMD_SOCK=/var/snap/iotconnect/common/iotc_cmd.sock

# --- PHT Click (MS8607) ------------------------------------------------------
PHT_I2C_BUS=0
PHT_INTERVAL=10

# --- Vision ------------------------------------------------------------------
# VISION_SOURCE accepts a video file, a camera index such as 0, or an RTSP URL.
# VISION_EXTRA is appended verbatim; --loop restarts a file source at its end
# and is a no-op for cameras and streams.
VISION_PYTHON=/usr/bin/python3
VISION_SOURCE=/home/ubuntu/ppl-walking-640x360-5fps.mp4
VISION_MODEL=hog
VISION_CONF=0.35
VISION_FPS=2
VISION_SEND_INTERVAL=1
VISION_STREAM=vision.objects
VISION_WEB_PORT=8080
VISION_EXTRA=--loop
